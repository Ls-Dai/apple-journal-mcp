#!/bin/sh
# main only changes through pull requests, so commits belong on a branch.
# Enable once per clone: git config core.hooksPath .githooks

if [ "$(git symbolic-ref --short -q HEAD)" = "main" ]; then
  echo "pre-commit: refusing to commit directly to main." >&2
  echo "  Move your work to a branch (uncommitted changes come along):" >&2
  echo "    git switch -c <branch>" >&2
  echo "  then commit there and open a pull request." >&2
  exit 1
fi
